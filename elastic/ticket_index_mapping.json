{
  "settings": {
    "analysis": {
      "analyzer": {
        "ticket_search_analyzer": {
          "type": "custom",
          "tokenizer": "standard",
          "filter": [
            "lowercase",
            "asciifolding"
          ]
        },
        "ticket_autocomplete_analyzer": {
          "type": "custom",
          "tokenizer": "ticket_autocomplete_tokenizer",
          "filter": [
            "lowercase",
            "asciifolding"
          ]
        }
      },
      "tokenizer": {
        "ticket_autocomplete_tokenizer": {
          "type": "edge_ngram",
          "min_gram": 2,
          "max_gram": 20,
          "token_chars": [
            "letter",
            "digit"
          ]
        }
      },
      "normalizer": {
        "lowercase_keyword": {
          "type": "custom",
          "filter": [
            "lowercase",
            "asciifolding"
          ]
        }
      }
    }
  },
  "mappings": {
    "dynamic": "false",
    "properties": {
      "ticket_id": {
        "type": "long"
      },
      "match_id": {
        "type": "long"
      },
      "sport": {
        "type": "text",
        "analyzer": "ticket_search_analyzer",
        "fields": {
          "keyword": {
            "type": "keyword",
            "normalizer": "lowercase_keyword"
          },
          "autocomplete": {
            "type": "text",
            "analyzer": "ticket_autocomplete_analyzer",
            "search_analyzer": "ticket_search_analyzer"
          }
        }
      },
      "home_team": {
        "type": "text",
        "analyzer": "ticket_search_analyzer",
        "fields": {
          "keyword": {
            "type": "keyword",
            "normalizer": "lowercase_keyword"
          },
          "autocomplete": {
            "type": "text",
            "analyzer": "ticket_autocomplete_analyzer",
            "search_analyzer": "ticket_search_analyzer"
          }
        }
      },
      "away_team": {
        "type": "text",
        "analyzer": "ticket_search_analyzer",
        "fields": {
          "keyword": {
            "type": "keyword",
            "normalizer": "lowercase_keyword"
          },
          "autocomplete": {
            "type": "text",
            "analyzer": "ticket_autocomplete_analyzer",
            "search_analyzer": "ticket_search_analyzer"
          }
        }
      },
      "match_title": {
        "type": "text",
        "analyzer": "ticket_search_analyzer",
        "fields": {
          "autocomplete": {
            "type": "text",
            "analyzer": "ticket_autocomplete_analyzer",
            "search_analyzer": "ticket_search_analyzer"
          }
        }
      },
      "venue": {
        "type": "text",
        "analyzer": "ticket_search_analyzer",
        "fields": {
          "keyword": {
            "type": "keyword",
            "normalizer": "lowercase_keyword"
          },
          "autocomplete": {
            "type": "text",
            "analyzer": "ticket_autocomplete_analyzer",
            "search_analyzer": "ticket_search_analyzer"
          }
        }
      },
      "city": {
        "type": "text",
        "analyzer": "ticket_search_analyzer",
        "fields": {
          "keyword": {
            "type": "keyword",
            "normalizer": "lowercase_keyword"
          }
        }
      },
      "match_time": {
        "type": "date",
        "format": "strict_date_optional_time||yyyy-MM-dd HH:mm:ss||yyyy-MM-dd"
      },
      "category": {
        "type": "text",
        "analyzer": "ticket_search_analyzer",
        "fields": {
          "keyword": {
            "type": "keyword",
            "normalizer": "lowercase_keyword"
          }
        }
      },
      "section_name": {
        "type": "keyword",
        "normalizer": "lowercase_keyword"
      },
      "row_number": {
        "type": "keyword"
      },
      "seat_number": {
        "type": "keyword"
      },
      "price": {
        "type": "scaled_float",
        "scaling_factor": 100
      },
      "available_capacity": {
        "type": "integer"
      },
      "ticket_status": {
        "type": "keyword",
        "normalizer": "lowercase_keyword"
      },
      "features": {
        "type": "keyword",
        "normalizer": "lowercase_keyword"
      },
      "search_text": {
        "type": "text",
        "analyzer": "ticket_search_analyzer",
        "fields": {
          "autocomplete": {
            "type": "text",
            "analyzer": "ticket_autocomplete_analyzer",
            "search_analyzer": "ticket_search_analyzer"
          }
        }
      },
      "indexed_at": {
        "type": "date",
        "format": "strict_date_optional_time"
      }
    }
  }
}
